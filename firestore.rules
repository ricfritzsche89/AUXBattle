rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lobbies/{lobbyId} {
      allow read, write: if true; // In prod: only for lobby members
    }
    match /songs/{songId} {
      allow create: if request.resource.data.lobbyId != null;
      allow read: if true; 
      // In prod: allow read only if isRevealed == true OR request.auth.uid == data.submittedBy
    }
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
